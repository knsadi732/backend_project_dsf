# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL — same server/user for both, only the database differs.
# IS_TEST=true connects to PGDATABASE_TEST; IS_TEST=false connects to
# PGDATABASE_PRODUCTION (see src/config/env.js). Defaults to true (test) if
# unset, so an accidental deploy without this var never lands on production.
PGHOST=localhost
PGPORT=5432
IS_TEST=true
PGDATABASE_TEST=dsfbackend_test
PGDATABASE_PRODUCTION=dsfbackend_production
PGUSER=postgres
PGPASSWORD=postgres
PG_POOL_MAX=20
PG_SSL=false
# Windows only — full path to pg_dump.exe if it isn't on PATH (used by the daily backup job)
PG_DUMP_PATH=pg_dump

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Documents (Service-04)
STORAGE_ROOT=./storage
DOC_SIGNING_SECRET=change_me_doc_signing_secret
DOC_PRESIGNED_URL_EXPIRES_IN=5m
DOC_MAX_UPLOAD_SIZE_MB=10

# SMTP (Service-06 email notifications) — Gmail requires a 16-char App Password, not your login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
